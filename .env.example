# ==========================================
# 仓库监控系统配置文件模板 (Warehouse Monitoring System Template)
# ==========================================

# ==========================================
# 1. 模块: FaceCapture (人脸识别与抓拍)
# ==========================================
FACE_API_URL=http://your-compreface-url:8001/api/v1/recognition/recognize
FACE_API_KEY=your-api-key
FACE_API_INTERVAL=2.0
FACE_CONFIDENCE_THRESHOLD=0.55
FACE_COOLDOWN_DURATION=600.0
FACE_VISITOR_BUFFER_DURATION=10.0
FACE_MIN_DETECTION_DURATION=0.1
FACE_MIN_AREA_RATIO=0.0
FACE_TRACKING_TIMEOUT=5.0
FACE_REPORT_INTERVAL=1.0
FACE_CAPTURE_WINDOW=1
FACE_MIN_QUALITY_THRESHOLD=0.8
FACE_MIN_ACCEPT_THRESHOLD=0.1

# ==========================================
# 2. 模块: TimeCapture (时间/人员离开检测)
# ==========================================
RTSP_URL_TIMECAPTURE=rtsp://user:pass@host:port/path
RTSP_URL_BACKUP_BASE=rtsp://user:pass@host:port/path
TIME_CONFIDENCE_THRESHOLD=0.6
TIME_PERSON_TIMEOUT=12.0
TIME_AGENT_API_KEY=your-api-key
TIME_AGENT_WORKFLOW_ID=your-workflow-id

# ==========================================
# 3. 模块: AssetScanning (资产扫描/RFID)
# ==========================================
RFID_CONN_STR=/dev/ttyACM0
RFID_POWER=2000

# ==========================================
# 4. 模块: Common / ToAgent (公共配置与Agent)
# ==========================================
AGENT_BASE_URL=http://your-agent-url/api/system/employee/webhook/invoke
AGENT_WORKFLOW_URL=http://your-agent-url/open/workflow/execute
AGENT_API_KEY=your-api-key
AGENT_WORKFLOW_ID=your-workflow-id
EMPLOYEE_ID=your-employee-id
USER_ID=your-user-id
MINIO_UPLOAD_URL=http://your-minio-url/api/system/file/upload

# ==========================================
# 5. 模块: Feishu (飞书集成)
# ==========================================
FEISHU_APP_ID=your-app-id
FEISHU_APP_SECRET=your-app-secret
FEISHU_RECEIVE_ID=your-receive-id

# 工作流 API 配置
FEISHU_FEEDBACK_API_KEY=your-feedback-api-key
FEISHU_FEEDBACK_API_ID=your-feedback-workflow-id
FEISHU_CONFIRM_API_KEY=your-confirm-api-key
FEISHU_CONFIRM_API_ID=your-confirm-workflow-id
